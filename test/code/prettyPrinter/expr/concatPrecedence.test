Precedence of concatenation in PHP 7 and PHP 8
-----
<?php
('abc' . 1) + 2;
'abc' . (1 + 2);
(1 + 2) . (3 + 4);
(1 . 2) << 3;
1 . (2 << 3);
-----
!!version=8.0
('abc' . 1) + 2;
'abc' . 1 + 2;
1 + 2 . 3 + 4;
(1 . 2) << 3;
1 . 2 << 3;
-----
<?php
('abc' . 1) + 2;
'abc' . (1 + 2);
(1 + 2) . (3 + 4);
(1 . 2) << 3;
1 . (2 << 3);
-----
!!version=7.4
'abc' . 1 + 2;
'abc' . (1 + 2);
1 + 2 . (3 + 4);
1 . 2 << 3;
1 . (2 << 3);
